{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog-bot-html",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "blog.sakimu.com/*",
      "zone_name": "sakimu.com"
    }
  ]
}
